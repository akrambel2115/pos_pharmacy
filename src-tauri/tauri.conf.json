{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pharmacy POS",
  "version": "0.1.0",
  "identifier": "com.pospharmacy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pharmacy POS",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MzJENkE2RkJEOTNBMEEKUldRS090bjdwdFl5MmVROFp6WmFLamtTYjFzWG8reC9JdWFEanBSNm50bWtVa3l4ZDRvRzlmQWoK",
      "endpoints": [
        "https://github.com/akrambel2115/pos_pharmacy/releases/latest/download/latest.json"
      ]
    }
  }
}
